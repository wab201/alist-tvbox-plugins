      "owner": "Spider",
      "method": "playerContent",
      "instance": true,
      "args": [
        "",
        "opaque-play-id"
      ],
      "expected": {
        "parse": 0,
        "jx": 0,
        "playUrl": "",
        "url": "opaque-play-id",
        "header": {}
      }
