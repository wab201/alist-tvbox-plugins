    {
      "domain": "history_merge_normalize",
      "name": "history_normalizes_numeric_fields_and_drops_empty_key",
      "kind": "call",
      "owner": "module",
      "method": "_normalize_history_rows_shared",
      "args": [
        [
          {
            "key": "csp_AList@@@demo@@@1",
            "vodName": "Demo",
            "vodFlag": "S01E02",
            "position": "120000",
            "duration": "240000",
            "createTime": "1000",
            "revSort": 1,
            "revPlay": 0
          },
          {
            "key": "",
            "vodName": "drop"
          }
        ]
      ],
      "expected": [
        {
          "key": "csp_AList@@@demo@@@1",
          "vodName": "Demo",
          "vodFlag": "S01E02",
          "position": 120000,
          "duration": 240000,
          "createTime": 1000,
          "revSort": 1,
          "revPlay": 0
        }
      ]
    },
    {
      "domain": "history_merge_normalize",
      "name": "history_merge_uses_cloud_rank_without_followplay_reference",
      "kind": "call",
      "owner": "Spider",
      "method": "_merge_native_history",
      "instance": true,
      "args": [
        [
          {
            "key": "csp_AList@@@demo@@@1",
            "vodName": "Demo",
            "vodFlag": "S01E03",
            "position": 100,
            "duration": 1000,
            "createTime": 2000
          }
        ],
        [
          {
            "key": "demo",
            "vodName": "Demo",
            "vodFlag": "S01E02",
            "position": 500,
            "duration": 1000,
            "createTime": 3000,
            "uid": 7
          }
        ]
      ],
      "expected": [
        [
          {
            "key": "demo",
            "vodName": "Demo",
            "vodFlag": "S01E02",
            "position": 500,
            "duration": 1000,
            "createTime": 3000,
            "uid": 7,
            "cid": 0
          }
        ],
        []
      ]
    },
    {
      "domain": "cache_hit_expiry",
      "name": "cache_returns_fresh_memory_entry",
      "kind": "cache_lookup",
      "setup": {
        "now": 1000,
        "ttl": 30,
        "stale_ttl": 300,
        "key": "fresh",
        "entries": [
          [
            "fresh",
            990,
            {
              "value": "hit"
            }
          ]
        ]
      },
      "expected": {
        "value": "hit"
      }
    },
    {
      "domain": "cache_hit_expiry",
      "name": "cache_removes_entry_beyond_stale_ttl",
      "kind": "cache_lookup",
      "setup": {
        "now": 1000,
        "ttl": 30,
        "stale_ttl": 300,
        "key": "expired",
        "entries": [
          [
            "expired",
            100,
            {
              "value": "old"
            }
          ]
        ]
      },
      "expected": null
    },
    {
      "domain": "failure_fallback",
      "name": "detail_failure_clears_playable_routes",
      "kind": "call",
      "owner": "Spider",
      "method": "_resource_error_vod",
      "instance": true,
      "args": [
        {
          "vod_id": "demo",
          "vod_name": "Demo",
          "vod_director": "Director",
          "vod_content": "Summary",
          "vod_play_from": "Provider A",
          "vod_play_url": "Episode 1$1@a",
