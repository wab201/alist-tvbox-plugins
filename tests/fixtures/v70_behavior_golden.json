{
  "schema_version": 2,
  "cases": [
    {
      "domain": "metadata",
      "name": "plugin_metadata_contract",
      "kind": "source_metadata",
      "expected": {
        "id": "douban_tmdb_follow_single",
        "name": "豆瓣TMDB追更助手（AList-TVBox专用）",
        "version": "70"
      }
    },
    {
      "domain": "metadata",
      "name": "metadata_subject_id",
      "kind": "call",
      "owner": "Spider",
      "method": "_subject_id",
      "args": [
        "subject/1234567/"
      ],
      "expected": "1234567"
    },
    {
      "domain": "resource_search_selection",
      "name": "resource_title_score_selects_matching_season",
      "kind": "call",
      "owner": "Spider",
      "method": "_resource_score",
      "instance": true,
      "args": [
        {
          "vod_id": "demo-resource",
          "vod_name": "The Last of Us S02 2023",
          "_resource_mode": "vod"
        },
        {
          "title": "The Last of Us",
          "original_title": "",
          "title_aliases": [],
          "year": "2023",
          "season_count": 2,
          "trackingSeason": 2,
          "tracked_episode": "S02E03"
        },
        ""
      ],
      "expected": 580
    },
    {
      "domain": "resource_search_selection",
      "name": "resource_provider_label",
      "kind": "call",
      "owner": "Spider",
      "method": "_resource_provider_key",
      "args": [
        "Quark"
      ],
      "expected": "quark"
    },
    {
      "domain": "detail",
      "name": "detail_splits_resource_groups",
