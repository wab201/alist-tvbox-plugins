          ],
          "group_providers": [
            "quark",
            "ali"
          ],
          "group_quality": [
            {
              "height": 2160
            },
            {
              "height": 1080
            }
          ]
        }
      ],
      "expected": [
        {
          "vod_id": "demo",
          "vod_name": "Demo",
          "vod_play_from": "Provider A",
          "vod_play_url": "Episode 1$1@a#Episode 2$1@b",
          "group_seasons": [
            1
          ],
          "group_providers": [
            "quark"
          ],
          "group_quality": [
            {
              "height": 2160
            }
          ]
        },
        {
          "vod_id": "demo",
          "vod_name": "Demo",
          "vod_play_from": "Provider B",
          "vod_play_url": "Movie$2@c",
          "group_seasons": [
            0
          ],
          "group_providers": [
            "ali"
          ],
          "group_quality": [
            {
              "height": 1080
            }
          ]
        }
      ]
