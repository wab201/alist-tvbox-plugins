            {
              "name": "Provider A"
            }
          ]
        },
        "no verified route"
      ],
      "expected": {
        "vod_id": "demo",
        "vod_name": "Demo",
        "vod_director": "Director · 线路状态：no verified route",
        "vod_content": "Summary\n\n播放资源状态：no verified route",
        "vod_play_from": "",
        "vod_play_url": "",
        "vodFlags": []
      }
    },
    {
