{
  "schema_version": 1,
  "contract": "p1_include_dependency_contract",
  "scope": "ordered byte-preserving include chunks",
  "limitation": "P1 validates include order, monotonic layers, declared earlier-only dependencies, top-level imports, and adapter boundary references. P2 replaces this with a real module DAG.",
  "chunks": [
    {
      "path": "parts/00_module_prelude.pyinc",
      "layer": 0,
      "responsibility": "imports, constants, and process-wide compatibility prelude",
      "allowed_dependencies": []
    },
    {
      "path": "parts/01_runtime_components.pyinc",
      "layer": 1,
      "responsibility": "runtime transport and persistence helper components",
      "allowed_dependencies": ["parts/00_module_prelude.pyinc"]
    },
    {
      "path": "parts/02_filter.pyinc",
      "layer": 2,
      "responsibility": "AList-TVBox Filter adapter",
      "exports_adapter": "Filter",
      "allowed_dependencies": ["parts/00_module_prelude.pyinc", "parts/01_runtime_components.pyinc"]
    },
    {
      "path": "parts/03_spider_runtime.pyinc",
      "layer": 3,
      "responsibility": "FongMi Spider adapter and runtime entry methods",
      "exports_adapter": "Spider",
      "allowed_dependencies": ["parts/00_module_prelude.pyinc", "parts/01_runtime_components.pyinc", "parts/02_filter.pyinc"]
    },
    {
      "path": "parts/04_follow_workflows.pyinc",
      "layer": 4,
      "responsibility": "follow-list and refresh workflows",
      "allowed_dependencies": ["parts/00_module_prelude.pyinc", "parts/01_runtime_components.pyinc", "parts/02_filter.pyinc", "parts/03_spider_runtime.pyinc"]
    },
    {
      "path": "parts/05_history_sync.pyinc",
      "layer": 5,
      "responsibility": "history synchronization and resume matching",
      "allowed_dependencies": ["parts/00_module_prelude.pyinc", "parts/01_runtime_components.pyinc", "parts/02_filter.pyinc", "parts/03_spider_runtime.pyinc", "parts/04_follow_workflows.pyinc"]
    },
    {
      "path": "parts/06_resource_discovery.pyinc",
      "layer": 6,
      "responsibility": "resource discovery and provider normalization",
      "allowed_dependencies": ["parts/00_module_prelude.pyinc", "parts/01_runtime_components.pyinc", "parts/02_filter.pyinc", "parts/03_spider_runtime.pyinc", "parts/04_follow_workflows.pyinc", "parts/05_history_sync.pyinc"]
    },
    {
      "path": "parts/07_resource_ranking.pyinc",
      "layer": 7,
      "responsibility": "resource grouping, scoring, and ranking",
      "allowed_dependencies": ["parts/00_module_prelude.pyinc", "parts/01_runtime_components.pyinc", "parts/02_filter.pyinc", "parts/03_spider_runtime.pyinc", "parts/04_follow_workflows.pyinc", "parts/05_history_sync.pyinc", "parts/06_resource_discovery.pyinc"]
    },
    {
      "path": "parts/08_playback_transport.pyinc",
      "layer": 8,
      "responsibility": "playback routing, headers, and transport output",
      "allowed_dependencies": ["parts/00_module_prelude.pyinc", "parts/01_runtime_components.pyinc", "parts/02_filter.pyinc", "parts/03_spider_runtime.pyinc", "parts/04_follow_workflows.pyinc", "parts/05_history_sync.pyinc", "parts/06_resource_discovery.pyinc", "parts/07_resource_ranking.pyinc"]
    },
    {
      "path": "parts/09_metadata_and_utilities.pyinc",
      "layer": 9,
      "responsibility": "metadata endpoints and remaining utility methods",
      "allowed_dependencies": ["parts/00_module_prelude.pyinc", "parts/01_runtime_components.pyinc", "parts/02_filter.pyinc", "parts/03_spider_runtime.pyinc", "parts/04_follow_workflows.pyinc", "parts/05_history_sync.pyinc", "parts/06_resource_discovery.pyinc", "parts/07_resource_ranking.pyinc", "parts/08_playback_transport.pyinc"]
    }
  ]
}
